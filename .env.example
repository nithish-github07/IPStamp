# --- ROOT DIRECTORY .env (For Hardhat Deployment & Scripts) ---

# The URL that connects you to the Sepolia network (e.g., Infura, Alchemy, or public node)
SEPOLIA_URL=https://ethereum-sepolia-rpc.publicnode.com

# Your MetaMask wallet private key (used to pay gas fees - NEVER share the real one!)
PRIVATE_KEY=your_metamask_private_key_here

# Deployed addresses of your contracts
REGISTRY_ADDRESS=your_deployed_registry_contract_address_here
LICENSE_ADDRESS=your_deployed_license_contract_address_here


# --- FRONTEND DIRECTORY (frontend/.env) ---

# Deployed contract addresses for the React dApp
VITE_CONTRACT_ADDRESS=your_deployed_registry_contract_address_here
VITE_LICENSE_ADDRESS=your_deployed_license_contract_address_here
