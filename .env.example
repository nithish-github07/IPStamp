# --- ROOT DIRECTORY .env (For Hardhat Deployment) ---

# The URL that connects you to the Sepolia network (e.g., Infura, Alchemy, or public node)
SEPOLIA_URL=https://ethereum-sepolia-rpc.publicnode.com

# Your MetaMask wallet private key (used to pay gas fees - NEVER share the real one!)
PRIVATE_KEY=your_metamask_private_key_here

# The deployed address of your contract (used by verifyOwnership.js script)
REGISTRY_ADDRESS=your_deployed_contract_address_here


# --- FRONTEND DIRECTORY (frontend/.env) ---

# The deployed address of your contract for the React App
VITE_CONTRACT_ADDRESS=your_deployed_contract_address_here
